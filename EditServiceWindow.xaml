<Window x:Class="zadanie2.EditServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Услуга" Height="460" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Название услуги *"/>
        <TextBox Grid.Row="1" x:Name="txtTitle"/>

        <Label Grid.Row="2" Content="Цена (руб.) *"/>
        <TextBox Grid.Row="3" x:Name="txtCost"/>

        <Label Grid.Row="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Длительность (сек.) *  "/>
                <TextBlock Text="(3600 = 1 ч, 1800 = 30 мин)" Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Label>
        <TextBox Grid.Row="5" x:Name="txtDuration"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <Label Content="Скидка (%)" Margin="0,6,0,2"/>
                <TextBox x:Name="txtDiscount"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <Label Content="Изображение" Margin="0,6,0,2"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Выбрать" Click="BtnChooseImage_Click"
                            Padding="8,4" FontSize="11"
                            Background="White" BorderBrush="#CCCCCC"/>
                    <TextBlock x:Name="lblImagePath" Text="не выбрано" Foreground="Gray"
                               VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                               TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Label Grid.Row="7" Content="Описание"/>
        <TextBox Grid.Row="8" x:Name="txtDescription" Height="60" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Сохранить" Click="BtnSave_Click"
                    Padding="16,6" FontSize="12"
                    Background="#4CAF50" Foreground="White"
                    BorderBrush="Transparent" Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45a049"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Отмена" Click="BtnCancel_Click"
                    Padding="16,6" FontSize="12"
                    Background="White" BorderBrush="#CCCCCC">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
